{
  "name": "publicboatramps",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "refresh:fwc": "node scripts/import-fl-fwc.mjs --live",
